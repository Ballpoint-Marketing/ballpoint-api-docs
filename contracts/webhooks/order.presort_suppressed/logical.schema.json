{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.ballpointmarketing.com/contracts/webhooks/order.presort_suppressed/logical.schema.json",
  "title": "order.presort_suppressed logical payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "version", "created_at", "data"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Wrapped-payload identifier. It is not the transport deduplication key."
    },
    "type": { "const": "order.presort_suppressed" },
    "version": { "const": "2026-08-19" },
    "created_at": { "type": "string", "format": "date-time" },
    "data": { "$ref": "#/$defs/data" }
  },
  "$defs": {
    "recipient": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contactId", "addressType"],
      "properties": {
        "contactId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": ".*\\S.*",
          "description": "PropStream contact identifier echoed verbatim from the order recipient."
        },
        "addressType": {
          "type": "string",
          "enum": ["PROPERTY", "MAILING"]
        }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["orderId", "suppressedCount", "recipients"],
      "properties": {
        "orderId": {
          "type": "string",
          "minLength": 1,
          "description": "Ballpoint order identifier."
        },
        "suppressedCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000,
          "description": "Number of AccuZIP-removed physical pieces; always equals recipients.length."
        },
        "recipients": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "items": { "$ref": "#/$defs/recipient" },
          "description": "One entry per removed physical piece. Duplicate contact/address pairs are preserved."
        }
      }
    }
  }
}
